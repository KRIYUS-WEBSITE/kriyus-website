# ============================================================
# KRIYUS Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Google Apps Script Web App URL
# After deploying your Apps Script, paste the URL here
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycby6yScb63ek46mgd0xEF5qRo9kT2rF5GLEtGgXmSUGjGrtzHSElbxreIK4cAy41GG9t/exec

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Nodemailer (optional – for email notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
NOTIFY_EMAIL=murarikeys2002@gmail.com

# Node environment
NODE_ENV=development
